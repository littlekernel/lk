// <memory> for LK's freestanding C++ standard library subset.
//
// Provides addressof, default_delete, unique_ptr (single-object and array
// forms) with make_unique, and destroy_at/destroy.
//
// Deviations from a hosted implementation:
//  - no shared_ptr/weak_ptr (shared ownership needs an allocation and
//    atomics policy a kernel is better off making explicit)
//  - no allocator machinery (allocator, allocator_traits, pointer_traits)
//  - deleters must not be reference types
//  - no volatile-qualified overloads

namespace std {

template <typename T>
constexpr T *addressof(T &arg) noexcept {
    return __builtin_addressof(arg);
}

// taking the address of an rvalue is almost certainly a bug
template <typename T>
const T *addressof(const T &&) = delete;

template <typename T>
struct default_delete {
    constexpr default_delete() noexcept = default;

    // converting from a deleter of a derived type
    template <typename U, typename = enable_if_t<is_convertible<U *, T *>::value>>
    default_delete(const default_delete<U> &) noexcept {}

    void operator()(T *ptr) const {
        static_assert(sizeof(T) > 0, "default_delete of an incomplete type");
        delete ptr;
    }
};

template <typename T>
struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;

    template <typename U, typename = enable_if_t<is_convertible<U (*)[], T (*)[]>::value>>
    default_delete(const default_delete<U[]> &) noexcept {}

    template <typename U, typename = enable_if_t<is_convertible<U (*)[], T (*)[]>::value>>
    void operator()(U *ptr) const {
        static_assert(sizeof(U) > 0, "default_delete of an incomplete type");
        delete[] ptr;
    }
};

namespace internal {

// pointer + deleter storage; the empty base optimization keeps
// sizeof(unique_ptr<T>) == sizeof(T*) for stateless deleters.
template <typename Ptr, typename D, bool = is_empty<D>::value && !is_final<D>::value>
struct ptr_deleter_pair : private D {
    Ptr ptr_;

    constexpr ptr_deleter_pair() noexcept : ptr_(nullptr) {}
    constexpr ptr_deleter_pair(Ptr p) noexcept : ptr_(p) {}
    template <typename E>
    ptr_deleter_pair(Ptr p, E &&d) noexcept : D(std::forward<E>(d)), ptr_(p) {}

    D &deleter() noexcept { return *this; }
    const D &deleter() const noexcept { return *this; }
};

template <typename Ptr, typename D>
struct ptr_deleter_pair<Ptr, D, false> {
    Ptr ptr_;
    D deleter_;

    constexpr ptr_deleter_pair() noexcept : ptr_(nullptr), deleter_() {}
    constexpr ptr_deleter_pair(Ptr p) noexcept : ptr_(p), deleter_() {}
    template <typename E>
    ptr_deleter_pair(Ptr p, E &&d) noexcept : ptr_(p), deleter_(std::forward<E>(d)) {}

    D &deleter() noexcept { return deleter_; }
    const D &deleter() const noexcept { return deleter_; }
};

// detect a deleter-provided pointer type (D::pointer), else default to T*
template <typename T, typename D, typename = void>
struct unique_ptr_pointer {
    using type = T *;
};
template <typename T, typename D>
struct unique_ptr_pointer<T, D, void_t<typename remove_reference_t<D>::pointer>> {
    using type = typename remove_reference_t<D>::pointer;
};

} // namespace internal

template <typename T, typename D = default_delete<T>>
class unique_ptr {
    static_assert(!is_reference<D>::value,
                  "reference deleter types are not supported by this subset");

public:
    using element_type = T;
    using deleter_type = D;
    using pointer = typename internal::unique_ptr_pointer<T, D>::type;

    constexpr unique_ptr() noexcept {}
    constexpr unique_ptr(decltype(nullptr)) noexcept {}
    explicit unique_ptr(pointer p) noexcept : pair_(p) {}
    unique_ptr(pointer p, const D &d) noexcept : pair_(p, d) {}
    unique_ptr(pointer p, D &&d) noexcept : pair_(p, std::move(d)) {}

    unique_ptr(unique_ptr &&other) noexcept
        : pair_(other.release(), std::move(other.get_deleter())) {}

    // converting move (e.g. unique_ptr<Derived> -> unique_ptr<Base>)
    template <typename U, typename E,
              typename = enable_if_t<is_convertible<typename unique_ptr<U, E>::pointer,
                                                    pointer>::value &&
                                     !is_array<U>::value && is_convertible<E, D>::value>>
    unique_ptr(unique_ptr<U, E> &&other) noexcept
        : pair_(other.release(), std::move(other.get_deleter())) {}

    ~unique_ptr() { reset(); }

    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;

    unique_ptr &operator=(unique_ptr &&other) noexcept {
        reset(other.release());
        get_deleter() = std::move(other.get_deleter());
        return *this;
    }

    template <typename U, typename E,
              typename = enable_if_t<is_convertible<typename unique_ptr<U, E>::pointer,
                                                    pointer>::value &&
                                     !is_array<U>::value && is_assignable<D &, E &&>::value>>
    unique_ptr &operator=(unique_ptr<U, E> &&other) noexcept {
        reset(other.release());
        get_deleter() = std::move(other.get_deleter());
        return *this;
    }

    unique_ptr &operator=(decltype(nullptr)) noexcept {
        reset();
        return *this;
    }

    pointer release() noexcept {
        pointer p = pair_.ptr_;
        pair_.ptr_ = pointer();
        return p;
    }

    void reset(pointer p = pointer()) noexcept {
        pointer old = pair_.ptr_;
        pair_.ptr_ = p;
        if (old) {
            get_deleter()(old);
        }
    }

    void swap(unique_ptr &other) noexcept {
        std::swap(pair_.ptr_, other.pair_.ptr_);
        std::swap(get_deleter(), other.get_deleter());
    }

    pointer get() const noexcept { return pair_.ptr_; }
    deleter_type &get_deleter() noexcept { return pair_.deleter(); }
    const deleter_type &get_deleter() const noexcept { return pair_.deleter(); }
    explicit operator bool() const noexcept { return pair_.ptr_ != pointer(); }

    typename add_lvalue_reference<T>::type operator*() const {
        __LK_CXX_DEBUG_ASSERT(pair_.ptr_ != pointer());
        return *pair_.ptr_;
    }
    pointer operator->() const {
        __LK_CXX_DEBUG_ASSERT(pair_.ptr_ != pointer());
        return pair_.ptr_;
    }

private:
    internal::ptr_deleter_pair<pointer, D> pair_;
};

// array form
template <typename T, typename D>
class unique_ptr<T[], D> {
    static_assert(!is_reference<D>::value,
                  "reference deleter types are not supported by this subset");

public:
    using element_type = T;
    using deleter_type = D;
    using pointer = typename internal::unique_ptr_pointer<T, D>::type;

    constexpr unique_ptr() noexcept {}
    constexpr unique_ptr(decltype(nullptr)) noexcept {}
    explicit unique_ptr(pointer p) noexcept : pair_(p) {}
    unique_ptr(pointer p, const D &d) noexcept : pair_(p, d) {}
    unique_ptr(pointer p, D &&d) noexcept : pair_(p, std::move(d)) {}

    unique_ptr(unique_ptr &&other) noexcept
        : pair_(other.release(), std::move(other.get_deleter())) {}

    ~unique_ptr() { reset(); }

    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;

    unique_ptr &operator=(unique_ptr &&other) noexcept {
        reset(other.release());
        get_deleter() = std::move(other.get_deleter());
        return *this;
    }

    unique_ptr &operator=(decltype(nullptr)) noexcept {
        reset();
        return *this;
    }

    pointer release() noexcept {
        pointer p = pair_.ptr_;
        pair_.ptr_ = pointer();
        return p;
    }

    void reset(pointer p = pointer()) noexcept {
        pointer old = pair_.ptr_;
        pair_.ptr_ = p;
        if (old) {
            get_deleter()(old);
        }
    }

    void swap(unique_ptr &other) noexcept {
        std::swap(pair_.ptr_, other.pair_.ptr_);
        std::swap(get_deleter(), other.get_deleter());
    }

    pointer get() const noexcept { return pair_.ptr_; }
    deleter_type &get_deleter() noexcept { return pair_.deleter(); }
    const deleter_type &get_deleter() const noexcept { return pair_.deleter(); }
    explicit operator bool() const noexcept { return pair_.ptr_ != pointer(); }

    T &operator[](size_t i) const {
        __LK_CXX_DEBUG_ASSERT(pair_.ptr_ != pointer());
        return pair_.ptr_[i];
    }

private:
    internal::ptr_deleter_pair<pointer, D> pair_;
};

template <typename T, typename D>
inline void swap(unique_ptr<T, D> &a, unique_ptr<T, D> &b) noexcept {
    a.swap(b);
}

namespace internal {

template <typename T>
struct make_unique_result {
    using single = unique_ptr<T>;
};
template <typename T>
struct make_unique_result<T[]> {
    using array = unique_ptr<T[]>;
};
template <typename T, size_t N>
struct make_unique_result<T[N]> {
    struct bounded_arrays_not_allowed;
};

} // namespace internal

template <typename T, typename... Args>
typename internal::make_unique_result<T>::single make_unique(Args &&...args) {
    return unique_ptr<T>(new T(std::forward<Args>(args)...));
}

template <typename T>
typename internal::make_unique_result<T>::array make_unique(size_t n) {
    return unique_ptr<remove_extent_t<T>[]>(new remove_extent_t<T>[n]());
}

template <typename T, typename... Args>
typename internal::make_unique_result<T>::bounded_arrays_not_allowed
make_unique(Args &&...) = delete;

// comparisons

template <typename T1, typename D1, typename T2, typename D2>
inline bool operator==(const unique_ptr<T1, D1> &l, const unique_ptr<T2, D2> &r) {
    return l.get() == r.get();
}
template <typename T1, typename D1, typename T2, typename D2>
inline bool operator!=(const unique_ptr<T1, D1> &l, const unique_ptr<T2, D2> &r) {
    return l.get() != r.get();
}
template <typename T, typename D>
inline bool operator==(const unique_ptr<T, D> &p, decltype(nullptr)) noexcept {
    return !p;
}
template <typename T, typename D>
inline bool operator==(decltype(nullptr), const unique_ptr<T, D> &p) noexcept {
    return !p;
}
template <typename T, typename D>
inline bool operator!=(const unique_ptr<T, D> &p, decltype(nullptr)) noexcept {
    return static_cast<bool>(p);
}
template <typename T, typename D>
inline bool operator!=(decltype(nullptr), const unique_ptr<T, D> &p) noexcept {
    return static_cast<bool>(p);
}

// destroy_at / destroy

template <typename T>
void destroy_at(T *p) {
    p->~T();
}

template <typename It>
void destroy(It first, It last) {
    for (; first != last; ++first) {
        destroy_at(addressof(*first));
    }
}

} // namespace std

