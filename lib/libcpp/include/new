#pragma once

#include <stddef.h>

// <new> for LK's freestanding C++ standard library subset.
//
// Deviations from a hosted implementation:
//  - The kernel is built with -fno-exceptions, so the "throwing" operator
//    new forms panic on allocation failure instead of throwing
//    std::bad_alloc (they still never return nullptr). Use the nothrow
//    forms for fallible allocation.
//  - No std::bad_alloc, no set_new_handler/get_new_handler.

namespace std {

struct nothrow_t {
    explicit nothrow_t() = default;
};
inline constexpr nothrow_t nothrow{};

enum class align_val_t : size_t {};

template <typename T>
[[nodiscard]] constexpr T *launder(T *p) noexcept {
    return __builtin_launder(p);
}

} // namespace std

// Throwing forms: never return nullptr; panic on allocation failure.
void *operator new(size_t size);
void *operator new[](size_t size);
void *operator new(size_t size, std::align_val_t align);
void *operator new[](size_t size, std::align_val_t align);

// Nothrow forms: return nullptr on allocation failure.
void *operator new(size_t size, const std::nothrow_t &) noexcept;
void *operator new[](size_t size, const std::nothrow_t &) noexcept;
void *operator new(size_t size, std::align_val_t align, const std::nothrow_t &) noexcept;
void *operator new[](size_t size, std::align_val_t align, const std::nothrow_t &) noexcept;

// Placement forms.
inline void *operator new(size_t, void *ptr) noexcept { return ptr; }
inline void *operator new[](size_t, void *ptr) noexcept { return ptr; }

void operator delete(void *p) noexcept;
void operator delete[](void *p) noexcept;
void operator delete(void *p, size_t size) noexcept;
void operator delete[](void *p, size_t size) noexcept;
void operator delete(void *p, std::align_val_t align) noexcept;
void operator delete[](void *p, std::align_val_t align) noexcept;
void operator delete(void *p, size_t size, std::align_val_t align) noexcept;
void operator delete[](void *p, size_t size, std::align_val_t align) noexcept;
void operator delete(void *p, const std::nothrow_t &) noexcept;
void operator delete[](void *p, const std::nothrow_t &) noexcept;

