// <type_traits> for LK's freestanding C++ standard library subset.
//
// Derived from the Fuchsia subset, expanded to cover the commonly used
// C++17 surface: the _t alias and _v variable template forms, the
// construction/assignment/destruction trait families, decay, common_type,
// conjunction/disjunction/negation, is_convertible, make_signed/unsigned,
// and the add_*/remove_* modification traits. Compiler builtins are used
// wherever gcc 11+ and clang 14+ both provide them.
//
// Non-standard extensions kept from the Fuchsia version: is_signed_integer,
// is_unsigned_integer, match_cv, is_convertible_pointer, and the
// DECLARE_HAS_MEMBER_FN* macros. remove_cvref is provided from C++20.

namespace std {

template <typename T, T v>
struct integral_constant {
    static constexpr T value = v;

    using value_type = T;
    using type = integral_constant<T, v>;

    constexpr operator value_type() const noexcept { return value; }
    constexpr value_type operator()() const noexcept { return value; }
};

template <bool B>
using bool_constant = integral_constant<bool, B>;

using true_type = bool_constant<true>;
using false_type = bool_constant<false>;

// type_identity (C++20, also used internally by the add_* traits):

template <typename T>
struct type_identity {
    using type = T;
};

template <typename T>
using type_identity_t = typename type_identity<T>::type;

// remove_const / remove_volatile / remove_cv:

template <typename T>
struct remove_const {
    typedef T type;
};

template <typename T>
struct remove_const<const T> {
    typedef T type;
};

template <typename T>
struct remove_volatile {
    typedef T type;
};

template <typename T>
struct remove_volatile<volatile T> {
    typedef T type;
};

template <typename T>
struct remove_cv {
    typedef typename remove_volatile<typename remove_const<T>::type>::type type;
};

template <typename T>
using remove_const_t = typename remove_const<T>::type;
template <typename T>
using remove_volatile_t = typename remove_volatile<T>::type;
template <typename T>
using remove_cv_t = typename remove_cv<T>::type;

