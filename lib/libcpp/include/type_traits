template <typename T>
struct add_cv {
    using type = const volatile T;
};

template <typename T>
using add_const_t = typename add_const<T>::type;
template <typename T>
using add_volatile_t = typename add_volatile<T>::type;
template <typename T>
using add_cv_t = typename add_cv<T>::type;

