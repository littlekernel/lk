// construction / assignment / destruction trait families.
// The core queries are compiler builtins in both gcc 11+ and clang 14+; the
// nothrow forms are derived from noexcept() expressions to avoid relying on
// builtins that arrived at different times in the two compilers.

template <typename T, typename... Args>
struct is_constructible : bool_constant<__is_constructible(T, Args...)> {};

template <typename T, typename... Args>
struct is_trivially_constructible : bool_constant<__is_trivially_constructible(T, Args...)> {};

namespace internal {

template <bool, typename T, typename... Args>
struct is_nothrow_constructible_impl : false_type {};
template <typename T, typename... Args>
struct is_nothrow_constructible_impl<true, T, Args...>
    : bool_constant<noexcept(T(declval<Args>()...))> {};
// Single-argument form models direct-initialization (handles references).
template <typename T, typename Arg>
struct is_nothrow_constructible_impl<true, T, Arg>
    : bool_constant<noexcept(static_cast<T>(declval<Arg>()))> {};
// Zero-argument form value-initializes.
template <typename T>
struct is_nothrow_constructible_impl<true, T> : bool_constant<noexcept(T())> {};

} // namespace internal

template <typename T, typename... Args>
struct is_nothrow_constructible
    : internal::is_nothrow_constructible_impl<__is_constructible(T, Args...), T, Args...> {};

template <typename T>
struct is_default_constructible : is_constructible<T> {};
template <typename T>
struct is_trivially_default_constructible : is_trivially_constructible<T> {};
template <typename T>
struct is_nothrow_default_constructible : is_nothrow_constructible<T> {};

template <typename T>
struct is_copy_constructible : is_constructible<T, add_lvalue_reference_t<add_const_t<T>>> {};
template <typename T>
struct is_trivially_copy_constructible
    : is_trivially_constructible<T, add_lvalue_reference_t<add_const_t<T>>> {};
template <typename T>
struct is_nothrow_copy_constructible
    : is_nothrow_constructible<T, add_lvalue_reference_t<add_const_t<T>>> {};

template <typename T>
struct is_move_constructible : is_constructible<T, add_rvalue_reference_t<T>> {};
template <typename T>
struct is_trivially_move_constructible : is_trivially_constructible<T, add_rvalue_reference_t<T>> {};
template <typename T>
struct is_nothrow_move_constructible : is_nothrow_constructible<T, add_rvalue_reference_t<T>> {};

template <typename T, typename U>
struct is_assignable : bool_constant<__is_assignable(T, U)> {};

template <typename T, typename U>
struct is_trivially_assignable : bool_constant<__is_trivially_assignable(T, U)> {};

namespace internal {

template <bool, typename T, typename U>
struct is_nothrow_assignable_impl : false_type {};
template <typename T, typename U>
struct is_nothrow_assignable_impl<true, T, U>
    : bool_constant<noexcept(declval<T>() = declval<U>())> {};

} // namespace internal

template <typename T, typename U>
struct is_nothrow_assignable : internal::is_nothrow_assignable_impl<__is_assignable(T, U), T, U> {};

template <typename T>
struct is_copy_assignable
    : is_assignable<add_lvalue_reference_t<T>, add_lvalue_reference_t<add_const_t<T>>> {};
template <typename T>
struct is_trivially_copy_assignable
    : is_trivially_assignable<add_lvalue_reference_t<T>, add_lvalue_reference_t<add_const_t<T>>> {};
template <typename T>
struct is_nothrow_copy_assignable
    : is_nothrow_assignable<add_lvalue_reference_t<T>, add_lvalue_reference_t<add_const_t<T>>> {};

template <typename T>
struct is_move_assignable : is_assignable<add_lvalue_reference_t<T>, add_rvalue_reference_t<T>> {};
template <typename T>
struct is_trivially_move_assignable
    : is_trivially_assignable<add_lvalue_reference_t<T>, add_rvalue_reference_t<T>> {};
template <typename T>
struct is_nothrow_move_assignable
    : is_nothrow_assignable<add_lvalue_reference_t<T>, add_rvalue_reference_t<T>> {};

// is_destructible / is_trivially_destructible:

namespace internal {

template <typename T, typename = void>
struct is_destructible_impl : false_type {};
template <typename T>
struct is_destructible_impl<T, void_t<decltype(declval<T&>().~T())>> : true_type {};

template <typename T>
struct is_unbounded_array : false_type {};
template <typename T>
struct is_unbounded_array<T[]> : true_type {};

} // namespace internal

template <typename T>
struct is_destructible
    : conditional_t<is_reference<T>::value,
                    true_type,
                    conditional_t<is_void<T>::value || is_function<T>::value ||
                                      internal::is_unbounded_array<T>::value,
                                  false_type,
                                  internal::is_destructible_impl<remove_all_extents_t<remove_cv_t<T>>>>> {};

template <typename T>
#if __has_builtin(__is_trivially_destructible)
struct is_trivially_destructible
    : bool_constant<is_destructible<T>::value && __is_trivially_destructible(T)> {};
#else
struct is_trivially_destructible
    : bool_constant<is_destructible<T>::value && __has_trivial_destructor(T)> {};
#endif

